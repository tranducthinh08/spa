generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Branch {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  address     String
  phone       String
  city        String   @default("Hà Nội")
  status      String   @default("ACTIVE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rooms        RoomBed[]
  users        User[]
  appointments Appointment[]
  inventories  BranchInventory[]
  invoices     Invoice[]
}

model RoomBed {
  id        String   @id @default(cuid())
  branchId  String
  name      String
  code      String
  type      String   // AI_CABIN, VIP_SINGLE, COUPLE_SUITE
  status    String   @default("AVAILABLE") // AVAILABLE, OCCUPIED, MAINTENANCE
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branch       Branch        @relation(fields: [branchId], references: [id], onDelete: Cascade)
  appointments Appointment[]

  @@unique([branchId, code])
}

model User {
  id             String    @id @default(cuid())
  name           String
  email          String    @unique
  phone          String    @unique
  password       String    @default("plumeria123")
  role           String    // SUPER_ADMIN, BRANCH_MANAGER, RECEPTIONIST, THERAPIST, CUSTOMER
  avatar         String?
  branchId       String?
  specialty      String?   // For Therapists
  commissionRate Float     @default(0.10)
  loyaltyPoints  Int       @default(0)
  membershipTier String    @default("SILVER") // SILVER, GOLD, ROYAL_VIP
  healthNotes    String?   // Medical background & chronic conditions
  status         String    @default("ACTIVE") // ACTIVE, LOCKED
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  branch               Branch?           @relation(fields: [branchId], references: [id], onDelete: SetNull)
  customerPackages     CustomerPackage[]
  customerAppointments Appointment[]     @relation("CustomerAppointments")
  therapistAppointments Appointment[]    @relation("TherapistAppointments")
  commissions          StaffCommission[]
  invoices             Invoice[]
}

model ServiceCategory {
  id          String    @id @default(cuid())
  name        String
  code        String    @unique
  description String?
  sortOrder   Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  services Service[]
}

model Service {
  id              String   @id @default(cuid())
  categoryId      String
  code            String   @unique
  name            String
  description     String?
  durationMinutes Int      @default(60) // 60, 75, 90, 120
  singlePrice     Float    // Price for single session
  packageSessions Int      @default(1)  // e.g. 1, 3, 16
  packagePrice    Float?   // Price when bought as package
  requiresAiCabin Boolean  @default(false)
  imageUrl        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  category         ServiceCategory     @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  customerPackages CustomerPackage[]
  appointments     Appointment[]
  consumables      ServiceConsumable[]
}

model CustomerPackage {
  id                String    @id @default(cuid())
  code              String    @unique
  customerId        String
  serviceId         String
  totalSessions     Int       @default(16)
  usedSessions      Int       @default(0)
  remainingSessions Int       @default(16)
  purchaseDate      DateTime  @default(now())
  expiryDate        DateTime
  status            String    @default("ACTIVE") // ACTIVE, EXPIRED, EXHAUSTED
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  customer     User          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  service      Service       @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  appointments Appointment[]
}

model Appointment {
  id                  String   @id @default(cuid())
  bookingCode         String   @unique
  branchId            String
  customerId          String
  therapistId         String
  roomBedId           String
  serviceId           String
  customerPackageId   String?
  startTime           DateTime
  endTime             DateTime
  status              String   @default("CONFIRMED") // PENDING, CONFIRMED, CHECKED_IN, IN_PROGRESS, COMPLETED, CANCELLED
  healthNotes         String?  // Biometric vitals, pulse, neck/shoulder pain, AI delta wave instructions
  postSessionFeedback String?
  rating              Int?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  branch          Branch           @relation(fields: [branchId], references: [id], onDelete: Cascade)
  customer        User             @relation("CustomerAppointments", fields: [customerId], references: [id], onDelete: Cascade)
  therapist       User             @relation("TherapistAppointments", fields: [therapistId], references: [id], onDelete: Cascade)
  roomBed         RoomBed          @relation(fields: [roomBedId], references: [id], onDelete: Cascade)
  service         Service          @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  customerPackage CustomerPackage? @relation(fields: [customerPackageId], references: [id], onDelete: SetNull)
  invoice         Invoice?
  commission      StaffCommission?
}

model Product {
  id           String   @id @default(cuid())
  code         String   @unique
  name         String
  unit         String   // ml, g, chai, goi, bo
  costPrice    Float
  sellingPrice Float?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  branchInventories BranchInventory[]
  serviceConsumables ServiceConsumable[]
}

model BranchInventory {
  id           String   @id @default(cuid())
  branchId     String
  productId    String
  quantity     Float    @default(0)
  reorderLevel Float    @default(10)
  updatedAt    DateTime @updatedAt

  branch  Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([branchId, productId])
}

model ServiceConsumable {
  id        String   @id @default(cuid())
  serviceId String
  productId String
  quantity  Float    // Consumed quantity per 1 treatment session
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([serviceId, productId])
}

model Invoice {
  id            String   @id @default(cuid())
  invoiceNumber String   @unique
  branchId      String
  customerId    String
  appointmentId String?  @unique
  totalAmount   Float
  discountAmount Float   @default(0)
  finalAmount   Float
  paymentMethod String   // CASH, BANK_TRANSFER, CARD, PACKAGE_REDEMPTION
  status        String   @default("PAID") // PENDING, PAID, REFUNDED
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  branch      Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)
  customer    User         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  appointment Appointment? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
}

model StaffCommission {
  id               String   @id @default(cuid())
  therapistId      String
  appointmentId    String   @unique
  serviceAmount    Float
  rate             Float
  commissionAmount Float
  status           String   @default("APPROVED") // PENDING, APPROVED, PAID
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  therapist   User        @relation(fields: [therapistId], references: [id], onDelete: Cascade)
  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
}
